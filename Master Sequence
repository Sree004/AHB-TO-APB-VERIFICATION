class master_seq extends uvm_sequence#(mst_xtn);
   `uvm_object_utils(master_seq)

function new(string name="master_seq");
   super.new(name);
endfunction

endclass

class single_seq extends master_seq;
  `uvm_object_utils(single_seq)

function new(string name="single_seq");
   super.new(name);
endfunction

task body();
//super.body();
req=mst_xtn::type_id::create("req");
start_item(req);
assert(req.randomize() with {Htrans==2'b10;
                             Hwrite==1'b1;
                             Hburst==3'b000;});
finish_item(req);
endtask
endclass

class incr_seq extends master_seq;
    `uvm_object_utils(incr_seq)

     bit[31:0] haddr;
     bit [9:0] hlen;
     bit [2:0] hburst,hsize;
     bit hwrite;

function new(string name="incr_seq");
   super.new(name);
endfunction
task body();
req=mst_xtn::type_id::create("req");
start_item(req);
assert(req.randomize with {Htrans==2'b10;
                           Hburst inside {1,3,5,7};});
finish_item(req);
haddr=req.Haddr;
hburst=req.Hburst;
hsize=req.Hsize;
hwrite=req.Hwrite;
hlen=req.Hlen;

for(int i=1;i<hlen;i++)
begin
   start_item(req);
   assert(req.randomize() with {Htrans==2'b11;
                                Hsize==hsize;
                                Hburst==hburst;
                                Hwrite==hwrite;
                                Haddr==haddr+(2**hsize);});
   finish_item(req);
   haddr=req.Haddr;
end
endtask
endclass

class wrap_seq extends master_seq;
  `uvm_object_utils(wrap_seq)
   bit[31:0] haddr,start_addr,boundry_addr;
   bit [2:0] hburst,hsize;
   bit [9:0] hlen;
   bit hwrite;

   function new(string name="wrap_seq");
   super.new(name);
   endfunction
task body();
req=mst_xtn::type_id::create("req");
start_item(req);
assert(req.randomize() with {Htrans==2'b10;
                           Hburst inside {2,4,6};});
finish_item(req);

haddr=req.Haddr;
hburst=req.Hburst;
hsize=req.Hsize;
hwrite=req.Hwrite;
hlen=req.Hlen;


start_addr=int'((haddr/((2**hsize)*(hlen)))*((2**hsize)*(hlen)));
boundry_addr=start_addr+((2**hsize)*(hlen));
haddr=req.Haddr+(2**hsize);

for(int i=1;i<hlen;i++)
  begin
      if(haddr>=boundry_addr)
         haddr=start_addr;
      start_item(req);
      assert(req.randomize() with {Htrans==2'b11;
                                   Hsize==hsize;
                                   Hburst==hburst;
                                   Hwrite==hwrite;
                                   Haddr==haddr;});
      finish_item(req);
      haddr=(2**hsize)+req.Haddr;
  end
endtask
endclass
