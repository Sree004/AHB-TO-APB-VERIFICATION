class master_agt_top extends uvm_env;
  `uvm_component_utils(master_agt_top)

master_config mst_cfg[];
master_agent agnth[];
env_config env_cfg;

extern function new(string name="master_agt_top",uvm_component parent);
extern function void build_phase(uvm_phase phase);
endclass

function master_agt_top::new(string name="master_agt_top",uvm_component parent);
super.new(name,parent);
endfunction

function void master_agt_top::build_phase(uvm_phase phase);
   super.build_phase(phase);
   if(!uvm_config_db#(env_config)::get(this,"","env_cfg",env_cfg))
    `uvm_fatal("ENV_CONFIG","Error from agent top")
   if(env_cfg.has_mst_agt)
    begin
     agnth=new[env_cfg.mst_no_of_dut];
     foreach(agnth[i])begin
        uvm_config_db#(master_config)::set(this,"*","mst_cfg",env_cfg.mst_cfg[i]);
        agnth[i]=master_agent::type_id::create($sformatf("agnth[%0d]",i),this);
        mst_cfg[i]=master_config::type_id::create($sformatf("mst_cfg[%0d]",i));
    end
   end
endfunction
